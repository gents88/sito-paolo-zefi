generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
}

model Category {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  name     String    @unique
  slug     String    @unique
  articles Article[]
  books    Book[]
  videos   Video[]
}

model Article {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  subtitle    String?
  description String?
  content     String
  image       String?
  tags        String[]  @default([])
  status      Status    @default(DRAFT)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  categoryId  String?   @db.ObjectId
  category    Category? @relation(fields: [categoryId], references: [id])
}

model Book {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  author      String
  description String?
  coverImage  String?
  amazonLink  String?
  pdfLink     String?
  createdAt   DateTime  @default(now())
  categoryId  String?   @db.ObjectId
  category    Category? @relation(fields: [categoryId], references: [id])
}

model Video {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  youtubeUrl  String
  thumbnail   String?
  categoryId  String?   @db.ObjectId
  category    Category? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime  @default(now())
}

model Contact {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nome      String
  email     String
  oggetto   String
  messaggio String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  USER
}

enum Status {
  DRAFT
  PUBLISHED
}
