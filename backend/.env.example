NODE_ENV=development
PORT=3000
# MongoDB example URL. Prisma's MongoDB connector requires a replica set (even a single-node one for local dev).
# For MongoDB Atlas use the mongodb+srv:// connection string it gives you (no replicaSet param needed).
DATABASE_URL=mongodb://user:password@localhost:27017/sito_db?replicaSet=rs0
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRATION=24h
BCRYPT_ROUNDS=10
